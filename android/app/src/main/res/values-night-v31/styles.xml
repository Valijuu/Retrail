<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash. Without an explicit icon the system scales
         the adaptive launcher foreground (108dp bitmaps) up to the 240dp splash
         slot, which renders it visibly blurry; splash_icon is rendered at the
         240dp size per density from the 1024px master, framed like the
         launcher icon. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
