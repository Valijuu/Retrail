#!/usr/bin/env bash
# Refuses a commit that contains secrets (gitleaks) or staged Dart files that are not `dart format`ted (#59).
# Checks the staged content, not the working tree. Fix with:
#   dart format <files>  &&  git add <files>
# Skip once: git commit --no-verify

# Secret scan (gitleaks): this repo's core.hooksPath bypasses the global hook, so call it here.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --no-banner --redact -v || {
    echo "pre-commit: gitleaks found possible secrets. Remove them (rotate if real); false positives go into .gitleaksignore." >&2
    exit 1
  }
else
  echo "pre-commit: gitleaks not installed, secret scan skipped." >&2
fi

# Raw SQL must be a fixed literal with Variable arguments (no $-interpolation, no +, no variables).
command -v python3 >/dev/null 2>&1 && { python3 "$(git rev-parse --show-toplevel)/tool/check_raw_sql.py" || exit 1; }

command -v dart >/dev/null 2>&1 || exit 0

mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR -- '*.dart')
[ ${#files[@]} -eq 0 ] && exit 0

unformatted=()
for f in "${files[@]}"; do
  # The formatter picks its style from the package's language version, so
  # feed the staged blob in under its real path.
  if ! git show ":$f" | dart format --output=none --set-exit-if-changed \
      --stdin-name="$f" >/dev/null 2>&1; then
    unformatted+=("$f")
  fi
done

if [ ${#unformatted[@]} -gt 0 ]; then
  echo "pre-commit: not formatted — run: dart format ${unformatted[*]}" >&2
  exit 1
fi
exit 0
