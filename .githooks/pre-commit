#!/usr/bin/env bash
# Refuses a commit with secrets or SQL injection (claude-config checks), unsafe Drift raw SQL, or staged Dart
# files that are not `dart format`ted (#59).
# Checks the staged content, not the working tree. Fix with:
#   dart format <files>  &&  git add <files>
# Skip once: git commit --no-verify

# Security checks from claude-config (gitleaks, sql-guard, semgrep), fail closed. This repo's core.hooksPath
# bypasses the global dispatcher, so call them here.
checks="$HOME/.config/git/precommit-checks"
[ -x "$checks" ] || { echo "pre-commit: $checks is missing (install claude-config/bootstrap). Commit blocked." >&2; exit 1; }
"$checks" || exit 1

# Drift raw SQL must be a fixed literal with Variable arguments. Checks the staged Dart files, exported from the index.
command -v python3 >/dev/null 2>&1 || { echo "pre-commit: python3 missing, raw-SQL check cannot run. Commit blocked." >&2; exit 1; }
root="$(git rev-parse --show-toplevel)"
sql_tmp="$(mktemp -d)"; trap 'rm -rf "$sql_tmp"' EXIT INT TERM
git diff --cached --name-only -z --diff-filter=ACMR -- '*.dart' | git checkout-index -z --stdin --prefix="$sql_tmp/" \
  || { echo "pre-commit: could not export staged Dart files for the raw-SQL check. Commit blocked." >&2; exit 1; }
python3 "$root/tool/check_raw_sql.py" "$sql_tmp" || exit 1

command -v dart >/dev/null 2>&1 || exit 0

mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR -- '*.dart')
[ ${#files[@]} -eq 0 ] && exit 0

unformatted=()
for f in "${files[@]}"; do
  # The formatter picks its style from the package's language version, so
  # feed the staged blob in under its real path.
  if ! git show ":$f" | dart format --output=none --set-exit-if-changed \
      --stdin-name="$f" >/dev/null 2>&1; then
    unformatted+=("$f")
  fi
done

if [ ${#unformatted[@]} -gt 0 ]; then
  echo "pre-commit: not formatted — run: dart format ${unformatted[*]}" >&2
  exit 1
fi
exit 0
